DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/basic_rag

# gemini
GOOGLE_API_KEY=your_google_api_key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# app config
APP_NAME=Basic RAG
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# file uploads
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=20

# retireval
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.7

# loggin
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1
API_V2_PREFIX=/api/v2

# chat streaming
CHAT_HISTORY_MESSAGE_LIMIT=20
CHAT_MAX_MESSAGE_CHARACTERS=10000
CHAT_STREAM_FIRST_TOKEN_TIMEOUT_SECONDS=20
CHAT_STREAM_IDLE_TIMEOUT_SECONDS=30
CHAT_STREAM_TOTAL_TIMEOUT_SECONDS=120
CHAT_STREAM_MAX_BUFFERED_CHARACTERS=65536
CHAT_STREAM_PING_INTERVAL_SECONDS=15
GEMINI_CHAT_MAX_OUTPUT_TOKENS=4096

# cursor pagination
CURSOR_SIGNING_KEY=development-only-change-me
# CURSOR_PREVIOUS_SIGNING_KEY=